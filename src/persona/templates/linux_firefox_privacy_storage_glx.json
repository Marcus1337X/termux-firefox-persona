{
  "schema_version": 1,
  "templates": [
    {
      "schema_version": 1,
      "id": "linux-firefox-privacy-storage-glx-v1",
      "version": "1.0.0",
      "status": "candidate",
      "strict_eligible": false,
      "metadata": {
        "phase": 3,
        "description": "Candidate privacy, storage and network capabilities with desktop input, media codecs, Web Audio, fonts and software GLX",
        "identity_source": "local_firefox_probe",
        "execution_backend": "software",
        "hardware_class": "software",
        "verification_required": "current_environment_and_full_combination",
        "context_backend": "glx",
        "verification_scope": "Window and Dedicated/Shared/Service Worker font and basic shader/framebuffer behavior; native offline/realtime Web Audio rendering and trusted-input lifecycle; six fixed media fixtures require MediaCapabilities supported and native decode/playback",
        "limitations": [
          "Not an integrated GPU identity template",
          "Does not complete second-batch graphics qualification",
          "All requested Worker contexts require separate current-device evidence",
          "No claim of full extension, precision, texture or limits coverage",
          "Physical speaker output and microphone input are not verified",
          "Limited fixture profiles only: 64x64 video at 8 fps for 2 seconds; no claim of other profiles, resolutions, encoding, WebRTC or media devices"
        ],
        "font_scope": "Window and Worker local font visibility, generic aliases, Canvas/OffscreenCanvas pixels and TextMetrics",
        "audio_scope": "Native Web Audio sample processing and context lifecycle; no physical speaker or microphone verification",
        "media_scope": "Native decode/playback of the native-codecs-v1 fixtures only; no physical input/output verification",
        "input_scope": "Desktop pointer (fine), hover capability and zero touch points; window visibility and active focus",
        "privacy_scope": "Do Not Track and Global Privacy Control across window, worker and HTTP headers",
        "storage_scope": "Native localStorage, sessionStorage, indexedDB and Cache API availability and isolation",
        "network_scope": "Navigator online status consistency across window and workers"
      },
      "base_config": {
        "browser": {
          "family": "firefox",
          "platform": "Linux x86_64",
          "oscpu": "Linux x86_64",
          "app_version": "5.0 (X11)",
          "firefox_version": "runtime",
          "user_agent": "Mozilla/5.0 (X11; Linux x86_64; rv:{firefox_version_major}.0) Gecko/20100101 Firefox/{firefox_version_major}.0"
        },
        "graphics": {
          "identity_class": "native-linux-firefox",
          "hardware_class": "software",
          "execution_backend": "software",
          "context_backend": "glx",
          "vendor": "Mesa",
          "renderer": "llvmpipe, or similar",
          "webgl1": true,
          "webgl2": true
        },
        "input": {
          "pointer": "fine",
          "hover": true,
          "max_touch_points": 0
        },
        "appearance": {
          "color_scheme": "light",
          "reduced_motion": false,
          "forced_colors": false
        },
        "worker_graphics": {
          "contexts": [
            "dedicated",
            "shared",
            "service"
          ],
          "fonts": true,
          "webgl": true
        },
        "media": {
          "fixture_set": "native-codecs-v1",
          "codecs": [
            "h264",
            "vp8",
            "vp9",
            "av1",
            "aac",
            "opus"
          ],
          "scope": "native-decode-playback",
          "physical_input": "not_verified",
          "physical_output": "not_verified",
          "webrtc": "not_verified"
        },
        "interaction": {
          "visibility_state": "visible",
          "has_focus": true
        },
        "privacy": {
          "do_not_track": true,
          "global_privacy_control": true
        },
        "storage": {
          "local_storage": true,
          "session_storage": true,
          "indexed_db": true,
          "caches": true
        },
        "network": {
          "online": true
        }
      },
